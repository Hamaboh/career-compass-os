# 羅針盤キャリアOS ― 環境変数テンプレート
# Phase3技術設計（career-compass-tech-design.md）に基づく。
# 実際の値は .env にコピーして設定し、.env はコミットしない（.gitignore済み）。
# 値は開発用のダミーです。本番相当で使う場合は必ず生成し直してください。

# ---- 実行環境 ----
NODE_ENV=development

# ---- 公開URL / ポート ----
# Caddyがリバースプロキシとして1つのオリジンにまとめるため、
# ブラウザから見えるのは PUBLIC_APP_URL のみ（api/webは内部ポートで直接公開しない）
PUBLIC_APP_URL=https://localhost
API_INTERNAL_PORT=3001
WEB_INTERNAL_PORT=3000

# ---- PostgreSQL 16 ----
# Phase3 14.3節: app_backend と app_ai_service は「別ロール・別権限」が設計上の要件。
# ここで2つの接続文字列を分けておくことで、実装時にAI Orchestration Serviceが
# 誤ってapp_backendの全権限接続を使ってしまう事故を構造的に防ぐ。
#
# POSTGRES_SUPERUSER/PASSWORD: postgres公式イメージの初期化用スーパーユーザー（内部専用、
# アプリからは接続しない）。POSTGRES_USER=app_backend を敢えてこれと分離しているのは、
# PostgreSQLの仕様上スーパーユーザーは Row Level Security を常にバイパスするため
# （Phase3 17章のRLSが機能するには、アプリ接続ロールが非スーパーユーザーである必要がある。
# 2026-08-14、RLS動作確認テストでこの分離漏れが発覚し追加。infra/postgres/init参照）。
POSTGRES_SUPERUSER=pg_super
POSTGRES_SUPERUSER_PASSWORD=change_me_dev_only
POSTGRES_DB=career_compass
POSTGRES_USER=app_backend
POSTGRES_PASSWORD=change_me_dev_only
DATABASE_URL=postgresql://app_backend:change_me_dev_only@postgres:5432/career_compass?schema=public

# AI Orchestration Service専用ロール（Step 0以降、DDLでGRANTを絞って作成する。7.1/14.3節参照）
POSTGRES_AI_SERVICE_USER=app_ai_service
POSTGRES_AI_SERVICE_PASSWORD=change_me_dev_only
DATABASE_URL_AI_SERVICE=postgresql://app_ai_service:change_me_dev_only@postgres:5432/career_compass?schema=public

# ---- Redis 7（セッション/レート制限/OTP試行カウンタ/BullMQ） ----
REDIS_URL=redis://redis:6379

# ---- MinIO（Evidence添付・制度資料PDF保存） ----
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=change_me_dev_only
MINIO_ROOT_PASSWORD=change_me_dev_only
MINIO_BUCKET=career-compass-evidence
MINIO_USE_SSL=false

# ---- セッション/Cookie（16.1〜16.3節） ----
# __Host- プレフィックスは Secure必須・Domain属性なし・Path=/ が前提。
# ローカル開発でもCaddyがHTTPS終端するため、ローカル内部CA証明書経由で条件を満たす。
SESSION_COOKIE_NAME=__Host-session
SESSION_TTL_HOURS=8
CSRF_COOKIE_NAME=csrf_token

# ---- 招待/OTP/パスワードリセット（9〜10, 16.7節） ----
INVITATION_TOKEN_TTL_HOURS=72
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# ---- アカウントロック（16.8節） ----
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_WINDOW_MINUTES=15
LOGIN_LOCK_DURATION_MINUTES=30

# ---- Anthropic Claude API（14章、唯一の不可避コスト） ----
# AI Orchestration Service以外のモジュールからは絶対に参照しないこと（14.1節の絶対原則）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# claude-api skillの既定はOpus 5だが、本アプリは1〜10人規模の社内ツールでありコスト感応度が
# 高い（README/DESIGN_FREEZE記載の「ゼロインフラコスト」方針と同じ考え方）ため、
# 対話1往復あたりのコストを抑えられるSonnet 5を既定モデルとする（設計判断、完了報告に明記）。
ANTHROPIC_MODEL=claude-sonnet-5

# ---- メール送信（Nodemailer, 会社SMTP優先／無料枠API代替） ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="羅針盤キャリアOS <noreply@example.com>"
