{
  "name": "career-compass-os",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.extend.yml"],
  "service": "workspace",
  "workspaceFolder": "/workspaces/career-compass-os",
  "shutdownAction": "stopCompose",

  // Node 22はworkspaceイメージ自体(typescript-node:1-22-bookworm)に同梱済み。
  // features経由のNode導入はこのdockerComposeFile構成では機能しないことを確認済みのため
  // 使わない(docker-compose.extend.yml参照)。

  // Caddy(80) / web dev server(3000) / api dev server(3001)。
  // postgres(5432)/redis(6379)はdocker-compose.yml側で127.0.0.1限定公開のため、
  // ここで転送する必要はない(同一Codespace内のworkspaceコンテナからはservice名で到達可能)。
  "forwardPorts": [80, 3000, 3001],
  "portsAttributes": {
    "80": { "label": "Caddy (統合エントリーポイント)" },
    "3000": { "label": "Web (Next.js dev)" },
    "3001": { "label": "API (NestJS dev)" }
  },

  // .envの複製は initializeCommand(コンテナ作成"前"、ホスト側で実行)で行う必要がある。
  // docker-compose.yml側のapi/worker/webが env_file: .env を参照しているため、
  // `docker compose config` によるcompose設定の解決自体が.env不在だと即エラーになり、
  // コンテナが1つも作られる前に失敗する(postCreateCommandはコンテナ作成"後"にしか
  // 実行されないため、この問題を解決できない。2026-08-16、実機のCodespacesで
  // 「recovery containerへフォールバックし、目的のworkspaceコンテナが実際には
  // 一度も作られていない」ことをcreation.logで確認して発覚)。
  "initializeCommand": "[ -f .env ] || cp .env.example .env",

  // .envはDESIGN_FREEZE同様「秘密情報はコミットしない」原則により.gitignore対象。
  // Codespaces上でも実際のANTHROPIC_API_KEY等は各自Codespaces Secretsで上書きする想定。
  //
  // dockerクライアント(CLI)はイメージに同梱されていないため、ホストのDockerソケットを
  // マウントしただけでは操作できない(docker-compose.extend.yml参照)。
  // apt経由でdocker.io(CLIのみ実質使用)を導入し、nodeユーザーをdockerグループへ追加する
  // (グループ変更はターミナル再接続後に有効。それまでは `sudo docker ...` で代用可能)。
  "postCreateCommand": "sudo apt-get update -y && sudo apt-get install -y docker.io && sudo usermod -aG docker node && npm install",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Prisma.prisma",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }

  // remoteUserは意図的に指定しない。devcontainers/base系は既定ユーザーが"vscode"だが、
  // typescript-nodeイメージは"node"であり、明示的に"vscode"を指定すると
  // 実機のCodespacesで "unable to find user vscode: no matching entries in passwd file"
  // で失敗する(2026-08-16、実機検証で発覚)。指定を省略し、イメージ自身のUSERディレクティブに
  // 委ねることでこのミスマッチを構造的に避ける。
}
