# 羅針盤キャリアOS ― リバースプロキシ設定（Phase3 1.2/1.3節）
# 単一オリジンにまとめることでフロント/バック間のCORS設定を不要にする。
# /api/* は NestJS へ、それ以外は Next.js へ。
#
# LAN内アクセス（既定）: localhost またはマシンのローカルIPで自動的にローカル内部CA証明書が発行される。
# 外部公開する場合はこのブロックのアドレスを実際のドメイン名に置き換えると、
# 自動的にLet's Encryptの証明書取得に切り替わる（Caddyの標準動作、追加設定不要）。

localhost {
	encode gzip

	handle_path /api/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		# 2026-08-14 MVP完成フェーズのセキュリティ監査で修正: 旧設定は script-src に
		# 'unsafe-inline' 'unsafe-eval' blob: を含んでおり、Phase3 16.4節「インラインスクリプトを
		# 許可しない」という明示要件と矛盾していた（要件と実装の矛盾、design freezeルール3）。
		# 現在のapps/webはプレースホルダーページのみで、インラインスクリプト/evalへの依存はない
		# （Next.jsの本番ビルドはハイドレーションスクリプトを外部<script src>として配信し、
		# unsafe-evalはwebpackの開発モードでのみ必要になる)。Phase3の基本形どおりに戻す。
		# 将来、実際のフロントエンド実装で特定のライブラリがeval等を必要とすると判明した場合は、
		# その時点で理由を明示してCSPの例外を追加する（先回りで緩めない）。
		Content-Security-Policy "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'"
	}

	# Phase3 16.11節: リクエストボディサイズ上限（既定1MB。Evidence添付は別途上限を検討）
	request_body {
		max_size 1MB
	}
}
