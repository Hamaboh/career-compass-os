// 羅針盤キャリアOS ― Prismaスキーマ
//
// Step 0（認証基盤）: Phase3 5.A節「アイデンティティ・認証・監査ドメイン」の
// employees/units/invitations/otp_codes/sessions/password_reset_tokens/
// login_attempts/account_locks/audit_logs を実装する。
// 後続Step（目標階層・自己理解・SMART・制度接続・1on1等）のテーブルは、
// 該当ドメインの実装に着手するタイミングで追加する。
//
// 命名規約: Prismaモデル/フィールドはcamelCase、DBカラム/テーブルはPhase3 4.4節どおり
// snake_caseとし、@map/@@mapで対応させる。
//
// Phase3 14.3節: このスキーマが管理する接続ロールは app_backend。
// app_ai_service ロールへのGRANT設定は、AI機能に着手するStep以降に別枠のマイグレーションとして追加する
// （Step 0時点ではAI機能自体が存在しないため、未使用のロールを先んじて作らない）。
//
// Phase3 17章 Unit単位アクセス制御（RLS）: employeesテーブルに対するRLSポリシーは
// migrations/<timestamp>_enable_rls_employees/migration.sql で別途定義する
// （Prismaのスキーマ言語はCREATE POLICYを表現できないため、手書きSQLマイグレーションで補う）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- 列挙型 ---

/// Phase3 7章。packages/shared/src/rbac.ts の EmployeeRole と値を一致させる。
enum EmployeeRole {
  ADMIN
  UL
  MEMBER
  EXCLUDED

  @@map("employee_role")
}

/// Phase3 8.1節 アカウントライフサイクル
enum AccountStatus {
  pending
  active
  locked
  suspended
  deactivated

  @@map("account_status")
}

/// Phase3 9章 招待フロー（employees.invitation_status）
enum InvitationStatus {
  not_invited
  invited
  opened
  otp_verified
  activated

  @@map("invitation_status")
}

/// Phase3 9章 招待フロー（invitations.status、1 employeeに複数履歴を許す独立レコード）
enum InvitationRecordStatus {
  pending
  opened
  otp_verified
  activated
  expired
  revoked

  @@map("invitation_record_status")
}

/// Phase3 10章 OTPフロー
enum OtpStatus {
  active
  verified
  expired
  exhausted

  @@map("otp_status")
}

/// Phase3 14.2節 / 16章。人間の操作かシステム(AI/バッチ)の操作かを監査ログで区別する。
enum ActorType {
  human
  system

  @@map("actor_type")
}

// --- モデル ---

model Unit {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  primaryUlEmployeeId String?  @map("primary_ul_employee_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  /// Phase3 7.2節: units.primary_ul_employee_id と employees.role='UL' は独立した概念。
  primaryUl  Employee?   @relation("UnitPrimaryUl", fields: [primaryUlEmployeeId], references: [id])
  employees  Employee[]  @relation("EmployeeUnit")
  ulmMasters UlmMaster[]

  @@map("units")
}

model Employee {
  id                String           @id @default(uuid()) @db.Uuid
  email             String           @unique
  name              String
  role              EmployeeRole     @default(EXCLUDED)
  unitId            String?          @map("unit_id") @db.Uuid
  /// Phase3 5.A節 employees.position_id。当初(MVP完成フェーズ前半)はposition_masterの登録機能のみ
  /// 先行実装し、既存employeesモデルへの列追加を避けていたが、2026-08-15にユーザーから明示指示を
  /// 受けて追加した（design freezeルール1の「軽微な変更」を上回る既存テーブルへの列追加のため、
  /// 単独判断ではなく指示を受けてから実施）。NULLABLEのため既存データへの影響なし。
  positionId        String?          @map("position_id") @db.Uuid
  accountStatus     AccountStatus    @default(pending) @map("account_status")
  invitationStatus  InvitationStatus @default(not_invited) @map("invitation_status")
  /// 招待完了までnull。平文パスワードは一切保持しない（Argon2idハッシュのみ）。
  passwordHash      String?          @map("password_hash")
  passwordUpdatedAt DateTime?        @map("password_updated_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  unit                Unit?                @relation("EmployeeUnit", fields: [unitId], references: [id])
  position            Position?            @relation(fields: [positionId], references: [id])
  primaryUlForUnits   Unit[]               @relation("UnitPrimaryUl")
  invitations         Invitation[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  loginAttempts       LoginAttempt[]
  accountLocks        AccountLock[]
  auditLogsAsActor    AuditLog[]           @relation("AuditLogActor")

  // 自己分析〜目標形成ドメイン（このStepで追加）
  selfAnalysisSessions     SelfAnalysisSession[]
  selfAnalysisAnswers      SelfAnalysisAnswer[]
  selfAnalysisInsights     SelfAnalysisInsight[]
  dreamHypotheses          DreamHypothesis[]
  visions                  Vision[]
  whyRecords               WhyRecord[]
  directions               Direction[]
  longTermGoals            LongTermGoal[]
  checkpoints              Checkpoint[]
  institutionalConnections InstitutionalConnection[]
  goalCandidates           GoalCandidate[]

  // 目標確定後の継続支援ドメイン（このStepで追加）
  goalChangeLogs             GoalChangeLog[]
  actions                    Action[]
  evidences                  Evidence[]
  progressEntries            ProgressEntry[]
  reflections                Reflection[]
  goalAiInsights             GoalAiInsight[]
  reminderSchedules          ReminderSchedule[]
  oneOnOnePrepSheetsAsMember OneOnOnePrepSheet[] @relation("OneOnOnePrepSheetMember")
  oneOnOnePrepSheetsAsLeader OneOnOnePrepSheet[] @relation("OneOnOnePrepSheetLeader")
  oneOnOneSessionsAsMember   OneOnOneSession[]   @relation("OneOnOneSessionMember")
  oneOnOneSessionsAsLeader   OneOnOneSession[]   @relation("OneOnOneSessionLeader")

  // MVP完成フェーズ（ADMIN/UL/MEMBER全機能+通知）で追加
  notifications Notification[]

  @@index([unitId])
  @@index([role])
  @@map("employees")
}

model Invitation {
  id         String                 @id @default(uuid()) @db.Uuid
  employeeId String                 @map("employee_id") @db.Uuid
  tokenHash  String                 @unique @map("token_hash")
  status     InvitationRecordStatus @default(pending)
  expiresAt  DateTime               @map("expires_at")
  createdAt  DateTime               @default(now()) @map("created_at")
  revokedAt  DateTime?              @map("revoked_at")

  employee Employee  @relation(fields: [employeeId], references: [id])
  otpCodes OtpCode[]

  @@index([employeeId])
  @@map("invitations")
}

model OtpCode {
  id           String    @id @default(uuid()) @db.Uuid
  invitationId String    @map("invitation_id") @db.Uuid
  codeHash     String    @map("code_hash")
  status       OtpStatus @default(active)
  expiresAt    DateTime  @map("expires_at")
  maxAttempts  Int       @default(5) @map("max_attempts")
  attemptCount Int       @default(0) @map("attempt_count")
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  invitation Invitation @relation(fields: [invitationId], references: [id])

  @@index([invitationId])
  @@map("otp_codes")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  /// Redisが正、本テーブルは監査用の補助台帳（Phase3 16.1節）。生トークンは保持しない。
  tokenHash  String    @unique @map("token_hash")
  issuedAt   DateTime  @default(now()) @map("issued_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("sessions")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("password_reset_tokens")
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String?  @map("employee_id") @db.Uuid
  email         String
  success       Boolean
  failureReason String?  @map("failure_reason")
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")

  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([email])
  @@index([createdAt])
  @@map("login_attempts")
}

model AccountLock {
  id         String    @id @default(uuid()) @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  reason     String
  lockedAt   DateTime  @default(now()) @map("locked_at")
  unlockAt   DateTime  @map("unlock_at")
  unlockedAt DateTime? @map("unlocked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("account_locks")
}

model AuditLog {
  id              String    @id @default(uuid()) @db.Uuid
  actorEmployeeId String?   @map("actor_employee_id") @db.Uuid
  actorType       ActorType @default(human) @map("actor_type")
  /// 例: "auth.login", "employee.create", "invitation.create"（Phase3 15章）
  action          String
  targetType      String?   @map("target_type")
  targetId        String?   @map("target_id")
  /// パスワード・OTP・セッショントークン等の機微値は本テーブルに一切書き込まない（15.2節）。
  before          Json?
  after           Json?
  ipAddress       String?   @map("ip_address")
  createdAt       DateTime  @default(now()) @map("created_at")

  actor Employee? @relation("AuditLogActor", fields: [actorEmployeeId], references: [id])

  @@index([actorEmployeeId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// 自己分析〜目標形成ドメイン（このStep: Phase2 1〜4章・7〜9章に対応）
//
// このStepで実装するのは要求された15項目のみ（自己分析/質問エンジン/回答保存/AI分析/
// 強み・価値観整理/将来像/夢/Why/キャリア方向/目標階層/通過点/会社KPI関連付け/
// ULM関連付け/AIによる目標候補生成/ユーザーによる確定）。SMART誘導・確定前ゲート、
// Action/Evidence/Reflection（進捗系）、1on1支援は別Stepのスコープであり、ここでは
// 実装しない（design freezeルール4: 要件を勝手に拡張しない）。
//
// フィールド設計はPhase2 FOUNDATION §0.1〜0.4（目標階層モデル・9値ステータス語彙・
// source区分・心理指標の共通ルール）に厳密に準拠する。自己分析エンジン（1章）・
// 夢探索エンジン（2章）はPhase2原文を直接参照して実装した。Why探索エンジン（3章）・
// 目標階層モデル（4章）・制度連携（7〜9章）はFOUNDATIONで確定済みの型（WhyRecordの
// 保持フィールド一覧、目標階層の縦連鎖、InstitutionalConnectionの側面接続という設計）
// に忠実に、かつ本Stepまでに確立した命名規約・source区分パターンを一貫適用する形で
// 実装した。項目16（GoalCandidateのbased_on等）を除き、原文の章単位での逐語確認は
// 完了報告に申し送り事項として明記する。
// ============================================================================

/// Phase2 FOUNDATION §0.2の9値ステータス語彙。目標階層オブジェクト全般で共用する
/// （packages/shared の GOAL_HIERARCHY_STATUSES と同じ語彙）。
enum GoalHierarchyStatus {
  exploring
  provisional
  confirmed
  active
  stalled
  under_review
  achieved
  discontinued
  archived

  @@map("goal_hierarchy_status")
}

/// Phase2 FOUNDATION §0.3。ai_principles「AIの推測とユーザーの明示的回答をデータ上分離」の実装。
enum ContentSource {
  user_stated
  ai_inferred

  @@map("content_source")
}

/// Phase2 1.0節の13カテゴリ（要件22項目を集約したもの。HIDDEN_STRENGTHのみAI生成専用で直接質問しない）。
enum SelfAnalysisCategory {
  PAST_EXPERIENCE
  SUCCESS_ACHIEVEMENT
  FAILURE_DISSATISFACTION
  WORK_JOY
  WORK_PAIN
  STRENGTH_WEAKNESS
  INTEREST_CONCERN
  VALUES_NONNEGOTIABLE
  EXTERNAL_EVALUATION
  SKILL_CURRENT_FUTURE
  WORKPLACE_CHALLENGE
  IDEAL_STATE
  HIDDEN_STRENGTH

  @@map("self_analysis_category")
}

/// Phase2 1.3節。
enum InsightType {
  strength
  weakness
  value
  interest
  ideal_state
  challenge

  @@map("insight_type")
}

/// Phase2 2.2節。
enum DreamUserReaction {
  agree
  adjust
  reject
  undecided

  @@map("dream_user_reaction")
}

/// Phase2 2.3節。
enum DreamRevisionTrigger {
  new_self_analysis_data
  new_why_record
  periodic_review
  member_initiated

  @@map("dream_revision_trigger")
}

/// Phase2 FOUNDATION §0.1。WhyRecordはVision/Direction/LongTermGoal/Checkpointのいずれにも添付可能。
enum WhySubjectType {
  vision
  direction
  long_term_goal
  checkpoint

  @@map("why_subject_type")
}

/// Phase2 FOUNDATION §0.1。InstitutionalConnectionはLongTermGoalまたはCheckpointに側面接続される。
enum InstitutionConnectableType {
  long_term_goal
  checkpoint

  @@map("institution_connectable_type")
}

enum InstitutionType {
  kpi
  ulm

  @@map("institution_type")
}

/// Phase2 FOUNDATION §0.4。5段階の質的ラベル（生スコアは内部値のみ、外部にはこのenumのみ公開）。
enum RelevanceLabel {
  very_low
  low
  medium
  high
  very_high

  @@map("relevance_label")
}

/// kpi_master/ulm_masterの簡易ステータス（9値語彙とは別名前空間、FOUNDATION §0.2の「それ以外の
/// ワークフロー・運用ログ用レコード」に該当。目標階層のstatusを置き換えるものではない）。
enum InstitutionMasterStatus {
  active
  provisional
  archived

  @@map("institution_master_status")
}

/// 目標階層のstatusとは別名前空間（FOUNDATION §0.2準拠、置き換えではない）。
enum GoalCandidateStatus {
  proposed
  accepted
  rejected

  @@map("goal_candidate_status")
}

model SelfAnalysisSession {
  id                String                 @id @default(uuid()) @db.Uuid
  employeeId        String                 @map("employee_id") @db.Uuid
  /// exploring=対話中/stalled=中断放置/under_review=カテゴリ一巡後の本人確認待ち/
  /// confirmed=本人が内容を確認済/archived=新セッション発生により過去化（Phase2 1.1節）
  status            GoalHierarchyStatus    @default(exploring)
  coveredCategories SelfAnalysisCategory[] @map("covered_categories")
  skippedCategories SelfAnalysisCategory[] @map("skipped_categories")
  startedAt         DateTime               @default(now()) @map("started_at")
  lastActivityAt    DateTime               @default(now()) @map("last_activity_at")

  employee Employee             @relation(fields: [employeeId], references: [id])
  answers  SelfAnalysisAnswer[]

  @@index([employeeId])
  @@map("self_analysis_sessions")
}

model SelfAnalysisAnswer {
  id                       String               @id @default(uuid()) @db.Uuid
  sessionId                String               @map("session_id") @db.Uuid
  /// RLSを単純化するため親セッション経由ではなく直接持たせる（design_freezeルール1の軽微な実装判断）。
  employeeId               String               @map("employee_id") @db.Uuid
  categoryCode             SelfAnalysisCategory @map("category_code")
  questionText             String               @map("question_text")
  /// 0=基本問, 1-2=深掘り問（Phase2 1.0節のSelfAnalysisQuestion.depth_levelに対応）
  depthLevel               Int                  @default(0) @map("depth_level")
  /// 本人回答原文。source=user_stated固定（このフィールド自体がuser_statedの実装）。
  rawText                  String?              @map("raw_text")
  /// 「わからない/答えたくない」選択（Phase2 1.1節(d)手順4）
  isSkip                   Boolean              @default(false) @map("is_skip")
  /// ai_inferred。1.2節参照、UL/Adminには一切開示しない内部制御値。APIレスポンスにも含めない。
  emotionIntensityInternal Int?                 @map("emotion_intensity_internal")
  /// ai_inferred。AIが抽出したキーワード（1.2節）
  topicTags                String[]             @map("topic_tags")
  createdAt                DateTime             @default(now()) @map("created_at")

  session  SelfAnalysisSession @relation(fields: [sessionId], references: [id])
  employee Employee            @relation(fields: [employeeId], references: [id])

  @@index([sessionId])
  @@index([employeeId])
  @@map("self_analysis_answers")
}

model SelfAnalysisInsight {
  id                      String              @id @default(uuid()) @db.Uuid
  employeeId              String              @map("employee_id") @db.Uuid
  insightType             InsightType         @map("insight_type")
  /// ai_inferred。AIが要約した仮説文（Phase2 1.3節）
  contentText             String              @map("content_text")
  /// 根拠回答へのトレーサビリティ（Phase2 1.3節「根拠のない仮説を作らせない」実装規約）
  derivedFromAnswerIds    String[]            @map("derived_from_answer_ids")
  /// ai_inferred。ConfidenceEstimator算出。生値は非公開、5段階ラベル変換後のみ公開する。
  confidenceScoreInternal Int?                @map("confidence_score_internal")
  status                  GoalHierarchyStatus @default(exploring)
  userApproved            Boolean             @default(false) @map("user_approved")
  /// user_stated。本人が「少し違う」を選んだ場合の本人語での上書き文（Phase2 1.3節(d)手順4）
  userEditText            String?             @map("user_edit_text")
  /// 「自分では気づいていない強み」（Phase2 1.4節、HIDDEN_STRENGTHカテゴリ専用）
  hiddenStrengthFlag      Boolean             @default(false) @map("hidden_strength_flag")
  gapEvidenceAnswerIds    String[]            @map("gap_evidence_answer_ids")
  version                 Int                 @default(1)
  createdAt               DateTime            @default(now()) @map("created_at")
  reviewedAt              DateTime?           @map("reviewed_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("self_analysis_insights")
}

model DreamHypothesis {
  id                      String              @id @default(uuid()) @db.Uuid
  employeeId              String              @map("employee_id") @db.Uuid
  /// 同一探索ラウンドで生成された複数仮説をグルーピング（Phase2 2.1節）
  clusterId               String              @map("cluster_id") @db.Uuid
  version                 Int                 @default(1)
  previousVersionId       String?             @map("previous_version_id") @db.Uuid
  /// バージョンごとに1本の文字列、1レコード内でsourceを混在させない（FOUNDATION §0.3）
  hypothesisText          String              @map("hypothesis_text")
  source                  ContentSource
  /// 生成根拠のトレーサビリティ（Phase2 2.1節「根拠なき決めつけ」防止の実装規約）
  generationBasis         Json                @map("generation_basis")
  confidenceScoreInternal Int?                @map("confidence_score_internal")
  status                  GoalHierarchyStatus @default(exploring)
  userReaction            DreamUserReaction?  @map("user_reaction")
  /// Vision昇格後のリンク（Phase2 2.4節）。昇格してもconfirmedのまま残す。
  linkedVisionId          String?             @map("linked_vision_id") @db.Uuid
  supersededAt            DateTime?           @map("superseded_at")
  createdAt               DateTime            @default(now()) @map("created_at")

  employee        Employee          @relation(fields: [employeeId], references: [id])
  previousVersion DreamHypothesis?  @relation("DreamHypothesisVersionChain", fields: [previousVersionId], references: [id])
  nextVersions    DreamHypothesis[] @relation("DreamHypothesisVersionChain")

  @@index([employeeId])
  @@index([clusterId])
  @@map("dream_hypotheses")
}

/// Phase2 2.3節。dreamHypothesisId/newVersionIdは監査目的の参照でありPrisma外部キー制約は課さない
/// （ログ的性格のテーブルであり、DreamHypothesisの自己参照バージョンチェーンとの多重関係を避けるため）。
model DreamHypothesisRevisionLog {
  id                String               @id @default(uuid()) @db.Uuid
  dreamHypothesisId String               @map("dream_hypothesis_id") @db.Uuid
  newVersionId      String               @map("new_version_id") @db.Uuid
  triggerReason     DreamRevisionTrigger @map("trigger_reason")
  /// ai_inferred。何が変わったかの要約(Phase2 2.3節)
  diffSummary       String?              @map("diff_summary")
  createdAt         DateTime             @default(now()) @map("created_at")

  @@index([dreamHypothesisId])
  @@map("dream_hypothesis_revision_logs")
}

model Vision {
  id                      String              @id @default(uuid()) @db.Uuid
  employeeId              String              @map("employee_id") @db.Uuid
  /// 昇格元DreamHypothesis。夢探索を経ずに本人が直接Visionを書いた場合はnull（Phase2 2.4節）
  originDreamHypothesisId String?             @map("origin_dream_hypothesis_id") @db.Uuid
  content                 String
  source                  ContentSource
  userApproved            Boolean             @default(false) @map("user_approved")
  status                  GoalHierarchyStatus @default(provisional)
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  employee   Employee    @relation(fields: [employeeId], references: [id])
  directions Direction[]

  @@index([employeeId])
  @@map("visions")
}

model Direction {
  id           String              @id @default(uuid()) @db.Uuid
  employeeId   String              @map("employee_id") @db.Uuid
  visionId     String              @map("vision_id") @db.Uuid
  content      String
  source       ContentSource
  userApproved Boolean             @default(false) @map("user_approved")
  status       GoalHierarchyStatus @default(provisional)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  employee      Employee       @relation(fields: [employeeId], references: [id])
  vision        Vision         @relation(fields: [visionId], references: [id])
  longTermGoals LongTermGoal[]

  @@index([employeeId])
  @@index([visionId])
  @@map("directions")
}

model LongTermGoal {
  id           String              @id @default(uuid()) @db.Uuid
  employeeId   String              @map("employee_id") @db.Uuid
  /// 会社KPI等に直接紐づかない目標も許容するため任意接続とする（FOUNDATION §0.1「Whyが添付可能」の
  /// 精神と同様、目標はDirectionなしでも作れる。ショートカット経路想定）。
  directionId  String?             @map("direction_id") @db.Uuid
  title        String
  description  String?
  targetDate   DateTime?           @map("target_date") @db.Date
  source       ContentSource
  userApproved Boolean             @default(false) @map("user_approved")
  status       GoalHierarchyStatus @default(provisional)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  // --- <smart_gate>要件: 保存直前のSMART監査結果。5項目それぞれをOK/要改善/不足で判定する。 ---
  /// Specific: 何をするのか
  smartSpecific       SmartAuditResult? @map("smart_specific")
  /// Measurable: 何をもって達成とするか
  smartMeasurable     SmartAuditResult? @map("smart_measurable")
  /// Achievable: 現実的に達成可能か
  smartAchievable     SmartAuditResult? @map("smart_achievable")
  /// Relevant: 夢・キャリア・Whyとつながっているか
  smartRelevant       SmartAuditResult? @map("smart_relevant")
  /// Time-bound: 期限はいつか
  smartTimebound      SmartAuditResult? @map("smart_timebound")
  smartAuditedAt      DateTime?         @map("smart_audited_at")
  /// 不足のまま本人が確定する場合の合理的理由（user_stated必須、<smart_gate>「本人が合理的な
  /// 理由を承認した場合のみ確定可能」の実装）。
  smartOverrideReason String?           @map("smart_override_reason")

  employee          Employee           @relation(fields: [employeeId], references: [id])
  direction         Direction?         @relation(fields: [directionId], references: [id])
  checkpoints       Checkpoint[]
  actions           Action[]
  progressEntries   ProgressEntry[]
  reflections       Reflection[]
  aiInsights        GoalAiInsight[]
  reminderSchedules ReminderSchedule[]

  @@index([employeeId])
  @@index([directionId])
  @@map("long_term_goals")
}

model Checkpoint {
  id             String              @id @default(uuid()) @db.Uuid
  employeeId     String              @map("employee_id") @db.Uuid
  longTermGoalId String              @map("long_term_goal_id") @db.Uuid
  title          String
  description    String?
  dueDate        DateTime?           @map("due_date") @db.Date
  source         ContentSource
  userApproved   Boolean             @default(false) @map("user_approved")
  status         GoalHierarchyStatus @default(provisional)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  employee          Employee           @relation(fields: [employeeId], references: [id])
  longTermGoal      LongTermGoal       @relation(fields: [longTermGoalId], references: [id])
  actions           Action[]
  progressEntries   ProgressEntry[]
  reflections       Reflection[]
  reminderSchedules ReminderSchedule[]

  @@index([employeeId])
  @@index([longTermGoalId])
  @@map("checkpoints")
}

/// Phase2 FOUNDATION §0.1。Vision/Direction/LongTermGoal/Checkpointのいずれにも添付できる独立オブジェクト。
/// Prismaは真の多態関連を持たないため、subjectType+subjectIdの組で表現する（DB外部キー制約なし、
/// アプリケーション層で整合性を保証する。Phase3 6.1節のポリモーフィック関連実装方針と同じパターン）。
model WhyRecord {
  id                       String              @id @default(uuid()) @db.Uuid
  employeeId               String              @map("employee_id") @db.Uuid
  subjectType              WhySubjectType      @map("subject_type")
  subjectId                String              @map("subject_id") @db.Uuid
  /// 深掘りの段階。1から始まり、納得できるまで本人の希望に応じて重ねていく（<why>要件）。
  depthLevel               Int                 @default(1) @map("depth_level")
  /// user_stated。本人の言葉。
  userText                 String?             @map("user_text")
  /// ai_inferred。AIが推測した理由（本人未承認の間はuser_approved=falseのまま確定情報として扱わない）。
  aiInferredReason         String?             @map("ai_inferred_reason")
  /// 関連過去経験（FOUNDATION §0.1のWhyRecord定義に明記された保持フィールド）
  relatedAnswerIds         String[]            @map("related_answer_ids")
  /// 関連価値観
  relatedInsightIds        String[]            @map("related_insight_ids")
  /// 関連する夢
  relatedDreamHypothesisId String?             @map("related_dream_hypothesis_id") @db.Uuid
  /// ai_inferred。納得度・確信度（FOUNDATION §0.4、生値は非公開、5段階ラベル変換後のみ公開）。
  convictionScoreInternal  Int?                @map("conviction_score_internal")
  source                   ContentSource
  userApproved             Boolean             @default(false) @map("user_approved")
  status                   GoalHierarchyStatus @default(exploring)
  /// 1つの上位層に複数のWhyRecordが積み上がってよい（更新履歴として保持、FOUNDATION §0.1）
  version                  Int                 @default(1)
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([subjectType, subjectId])
  @@map("why_records")
}

/// Phase3 5.B節「kpi_master（append-onlyバージョン管理）」。2026-08-15 ユーザー指示により
/// バージョン管理・公開ワークフローを追加。既存のtitle/description/statusは後方互換のため
/// 名称を変更せず維持し（institutional.service.tsの既存呼び出し元・InstitutionalConnectionの
/// 参照を壊さないため）、Phase3が定義するfamily_id/version_no/change_reasonのみ追加する
/// （kpi_name等への厳密なリネームは行わない、設計判断として完了報告に明記）。
model KpiMaster {
  id           String                  @id @default(uuid()) @db.Uuid
  /// 版を横断する安定ID。改定されても不変（Phase3 5.B節）。
  kpiFamilyId  String                  @default(uuid()) @map("kpi_family_id") @db.Uuid
  /// (kpiFamilyId, versionNo)がPhase3の要求するUNIQUE制約。
  versionNo    Int                     @default(1) @map("version_no")
  title        String
  description  String?
  /// version_no>=2で必須（アプリ層でCHECK、Phase3 5.B節）。
  changeReason String?                 @map("change_reason")
  status       InstitutionMasterStatus @default(active)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  @@unique([kpiFamilyId, versionNo])
  @@index([kpiFamilyId])
  @@map("kpi_master")
}

model UlmMaster {
  id           String                  @id @default(uuid()) @db.Uuid
  unitId       String?                 @map("unit_id") @db.Uuid
  ulmFamilyId  String                  @default(uuid()) @map("ulm_family_id") @db.Uuid
  versionNo    Int                     @default(1) @map("version_no")
  title        String
  description  String?
  changeReason String?                 @map("change_reason")
  status       InstitutionMasterStatus @default(active)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  unit Unit? @relation(fields: [unitId], references: [id])

  @@unique([ulmFamilyId, versionNo])
  @@index([unitId])
  @@index([ulmFamilyId])
  @@map("ulm_master")
}

/// 会社KPI/ULMとの側面接続。<company_alignment>要件どおり、KPI/ULM→本人の成長→キャリア→Whyの
/// 接続確認を必須フィールド(growthNote)として持たせる。接続なし（none）は本テーブルに行を
/// 作らないことで表現する（FOUNDATION §0.1「接続なしが正式な状態として許容される」）。
/// connectableId は connectableType に応じてLongTermGoal.idまたはCheckpoint.idを指す多態関連。
/// WhyRecordのsubjectType/subjectIdと同じ理由でPrisma外部キー制約は課さない
/// （1つの列が2つの異なるテーブルのいずれかを指すため、DBレベルのFK制約では表現できない）。
model InstitutionalConnection {
  id              String                     @id @default(uuid()) @db.Uuid
  employeeId      String                     @map("employee_id") @db.Uuid
  connectableType InstitutionConnectableType @map("connectable_type")
  connectableId   String                     @map("connectable_id") @db.Uuid
  institutionType InstitutionType            @map("institution_type")
  institutionId   String                     @map("institution_id") @db.Uuid
  relevanceLabel  RelevanceLabel             @map("relevance_label")
  /// user_stated必須。「このKPI/ULMはあなたのどんな成長につながりますか」への回答
  /// （<company_alignment>: KPI→本人の成長 の接続確認）。
  growthNote      String                     @map("growth_note")
  /// user_stated任意。本人のキャリアへの接続についての補足。
  careerNote      String?                    @map("career_note")
  /// このInstitutionalConnectionの接続先（LongTermGoal/Checkpoint）に紐づくWhyRecordを
  /// 本人が再確認したかどうか（<company_alignment>: キャリア→Why の接続確認、Phase4 23.9 K2対応）。
  whyReconfirmed  Boolean                    @default(false) @map("why_reconfirmed")
  source          ContentSource
  userApproved    Boolean                    @default(false) @map("user_approved")
  status          GoalHierarchyStatus        @default(provisional)
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([connectableType, connectableId])
  @@map("institutional_connections")
}

/// AIによる目標候補生成（<implementation_scope> 14番）。あくまで「提案」であり、
/// ユーザーが確定操作（15番）をしてはじめてLongTermGoal/Checkpointとして正式登録される。
model GoalCandidate {
  id                  String              @id @default(uuid()) @db.Uuid
  employeeId          String              @map("employee_id") @db.Uuid
  /// 生成根拠(自己分析insight/dream/whyのID等)。DreamHypothesis.generation_basisと同じ設計思想。
  basedOn             Json                @map("based_on")
  title               String
  description         String?
  /// ai_inferred。なぜこの候補を提案したか（<why>要件: 目標確定前に必ずWhyを掘り下げる、の材料）。
  rationale           String
  suggestedTargetDate DateTime?           @map("suggested_target_date") @db.Date
  status              GoalCandidateStatus @default(proposed)
  /// 確定されたLongTermGoalへのリンク（accepted時のみ設定）。
  acceptedGoalId      String?             @map("accepted_goal_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at")
  reviewedAt          DateTime?           @map("reviewed_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("goal_candidates")
}

/// Phase3 14.5節。AI呼び出し自体の技術的実行ログ（audit_logsとは別テーブル、ADMIN限定）。
model AiCallLog {
  id               String   @id @default(uuid()) @db.Uuid
  employeeId       String?  @map("employee_id") @db.Uuid
  /// Phase2 0.6の予約エージェント名のいずれか。
  agentName        String   @map("agent_name")
  promptTemplateId String   @map("prompt_template_id")
  model            String
  success          Boolean
  errorMessage     String?  @map("error_message")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([employeeId])
  @@index([createdAt])
  @@map("ai_call_logs")
}

// ============================================================================
// 目標確定後の継続支援ドメイン（このStep: AIエージェント/目標管理/1on1支援）
//
// <smart_guidance>/<smart_gate>/<goal_management>/<continuous_ai>/<one_on_one>/<reminder>の
// 実装。既存の目標階層（Vision/Direction/LongTermGoal/Checkpoint）・Why・GoalCandidateの
// 仕組みをそのまま土台とし、以下を追加する:
//   - LongTermGoalへのSMART監査フィールド追加（既存モデルの拡張、新規テーブルではない）
//   - GoalChangeLog: 目標変更履歴（ポリモーフィック、WhyRecordと同じsubjectType+subjectId方式）
//   - Action/Evidence: 行動と成果物
//   - ProgressEntry/Reflection: 進捗・振り返り
//   - GoalAiInsight: 課題発見・修正候補・次アクション提案（AIが「提案」し本人が「確定」する
//     <ai_principles>の一貫実装）。「次の目標」提案は既存GoalCandidate.generateCandidates()を
//     達成済み目標のコンテキストで再利用し、新規テーブルを増やさない。
//   - ReminderSchedule: 検証タイミング（期限・中間チェック・振り返り）。LongTermGoal確定時に
//     targetDateがあれば自動生成し、UL側の手動管理を不要にする（<reminder>要件）。
//   - OneOnOnePrepSheet/OneOnOneSession: 1on1準備（AI生成、UL専用・本人非公開）と実施記録
//     （UL記入、本人にも閲覧許可）。<one_on_one>「AIは最終判断をしない」の実装として、
//     PrepSheetは常にsource=ai_inferredで実際の判断はOneOnOneSession.notesにUL自身が記す。
// ============================================================================

/// <smart_gate>要件。目標保存直前のSMART監査5項目それぞれの判定。
enum SmartAuditResult {
  ok
  needs_improvement
  insufficient

  @@map("smart_audit_result")
}

/// GoalChangeLogの対象。Visionは編集履歴を追跡する運用が薄いため対象外（Direction以下のみ）。
enum GoalChangeSubjectType {
  direction
  long_term_goal
  checkpoint

  @@map("goal_change_subject_type")
}

enum GoalChangeAction {
  created
  updated
  status_changed
  confirmed
  smart_audited

  @@map("goal_change_action")
}

/// <goal_management>「目標変更履歴」の実装。ポリモーフィックのためDB外部キー制約は課さない
/// （WhyRecordと同じ設計判断）。
model GoalChangeLog {
  id          String                @id @default(uuid()) @db.Uuid
  employeeId  String                @map("employee_id") @db.Uuid
  subjectType GoalChangeSubjectType @map("subject_type")
  subjectId   String                @map("subject_id") @db.Uuid
  action      GoalChangeAction
  beforeValue Json?                 @map("before_value")
  afterValue  Json?                 @map("after_value")
  /// user_stated任意。変更理由（SMART不足のまま確定する場合のsmartOverrideReasonとは別に、
  /// 通常の編集についても理由を残せるようにする）。
  reason      String?
  changedAt   DateTime              @default(now()) @map("changed_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([subjectType, subjectId])
  @@map("goal_change_logs")
}

enum ActionStatus {
  not_started
  in_progress
  done
  blocked

  @@map("action_status")
}

/// <goal_management>「行動」。CheckpointまたはLongTermGoalの少なくとも一方に紐づく
/// （アプリケーション層で検証、DB制約では強制しない）。
model Action {
  id             String        @id @default(uuid()) @db.Uuid
  employeeId     String        @map("employee_id") @db.Uuid
  checkpointId   String?       @map("checkpoint_id") @db.Uuid
  longTermGoalId String?       @map("long_term_goal_id") @db.Uuid
  title          String
  description    String?
  dueDate        DateTime?     @map("due_date") @db.Date
  status         ActionStatus  @default(not_started)
  source         ContentSource
  userApproved   Boolean       @default(false) @map("user_approved")
  completedAt    DateTime?     @map("completed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  employee     Employee      @relation(fields: [employeeId], references: [id])
  checkpoint   Checkpoint?   @relation(fields: [checkpointId], references: [id])
  longTermGoal LongTermGoal? @relation(fields: [longTermGoalId], references: [id])
  evidences    Evidence[]

  @@index([employeeId])
  @@index([checkpointId])
  @@index([longTermGoalId])
  @@map("actions")
}

/// <goal_management>「成果物」。Actionの完了の証跡として添付する。
model Evidence {
  id          String        @id @default(uuid()) @db.Uuid
  employeeId  String        @map("employee_id") @db.Uuid
  actionId    String        @map("action_id") @db.Uuid
  title       String
  description String?
  /// MinIOへの実ファイルアップロードは本Stepのスコープ外（Step -1確定インフラのうち未着手の
  /// 部分、design freezeルール4に基づき既存技術スタックの範囲内でURL参照のみ実装する）。
  url         String?
  source      ContentSource @default(user_stated)
  submittedAt DateTime      @default(now()) @map("submitted_at")

  employee Employee @relation(fields: [employeeId], references: [id])
  action   Action   @relation(fields: [actionId], references: [id])

  @@index([employeeId])
  @@index([actionId])
  @@map("evidences")
}

/// <goal_management>「進捗」。CheckpointまたはLongTermGoalの少なくとも一方に紐づく。
model ProgressEntry {
  id              String        @id @default(uuid()) @db.Uuid
  employeeId      String        @map("employee_id") @db.Uuid
  longTermGoalId  String?       @map("long_term_goal_id") @db.Uuid
  checkpointId    String?       @map("checkpoint_id") @db.Uuid
  percentComplete Int?          @map("percent_complete")
  statusNote      String        @map("status_note")
  source          ContentSource @default(user_stated)
  recordedAt      DateTime      @default(now()) @map("recorded_at")

  employee     Employee      @relation(fields: [employeeId], references: [id])
  longTermGoal LongTermGoal? @relation(fields: [longTermGoalId], references: [id])
  checkpoint   Checkpoint?   @relation(fields: [checkpointId], references: [id])

  @@index([employeeId])
  @@index([longTermGoalId])
  @@index([checkpointId])
  @@map("progress_entries")
}

/// <goal_management>「振り返り」＋<continuous_ai>「振り返り」支援。promptはAIが投げかけた
/// 問い（ai_inferred、ログとして保持）、contentは本人の振り返り本文（user_stated）。
model Reflection {
  id             String        @id @default(uuid()) @db.Uuid
  employeeId     String        @map("employee_id") @db.Uuid
  longTermGoalId String?       @map("long_term_goal_id") @db.Uuid
  checkpointId   String?       @map("checkpoint_id") @db.Uuid
  prompt         String?
  content        String
  source         ContentSource @default(user_stated)
  createdAt      DateTime      @default(now()) @map("created_at")

  employee     Employee      @relation(fields: [employeeId], references: [id])
  longTermGoal LongTermGoal? @relation(fields: [longTermGoalId], references: [id])
  checkpoint   Checkpoint?   @relation(fields: [checkpointId], references: [id])

  @@index([employeeId])
  @@index([longTermGoalId])
  @@index([checkpointId])
  @@map("reflections")
}

/// <continuous_ai>「課題発見」「目標修正候補」「次アクション」の実装。「次の目標」は既存の
/// GoalCandidateを再利用するためここには含まない（コメント参照）。
enum GoalAiInsightKind {
  issue_detected
  revision_candidate
  next_action_suggestion

  @@map("goal_ai_insight_kind")
}

model GoalAiInsight {
  id                      String              @id @default(uuid()) @db.Uuid
  employeeId              String              @map("employee_id") @db.Uuid
  longTermGoalId          String              @map("long_term_goal_id") @db.Uuid
  kind                    GoalAiInsightKind
  contentText             String              @map("content_text")
  /// revision_candidateの場合、提案する変更内容(title/targetDate等)をここに保持し、
  /// acceptされた時点でLongTermGoalへ適用する。
  basedOn                 Json                @map("based_on")
  confidenceScoreInternal Int?                @map("confidence_score_internal")
  status                  GoalHierarchyStatus @default(exploring)
  userApproved            Boolean             @default(false) @map("user_approved")
  createdAt               DateTime            @default(now()) @map("created_at")
  reviewedAt              DateTime?           @map("reviewed_at")

  employee     Employee     @relation(fields: [employeeId], references: [id])
  longTermGoal LongTermGoal @relation(fields: [longTermGoalId], references: [id])

  @@index([employeeId])
  @@index([longTermGoalId])
  @@map("goal_ai_insights")
}

/// <reminder>要件。期限だけでなく中間チェック・振り返りも対象にする。LongTermGoal確定時に
/// targetDateがあれば自動生成し、UL側が手動で全員分を管理する必要をなくす。
enum ReminderTriggerType {
  interim_check
  deadline
  reflection

  @@map("reminder_trigger_type")
}

enum ReminderStatus {
  pending
  due
  completed
  skipped

  @@map("reminder_status")
}

model ReminderSchedule {
  id             String              @id @default(uuid()) @db.Uuid
  employeeId     String              @map("employee_id") @db.Uuid
  longTermGoalId String?             @map("long_term_goal_id") @db.Uuid
  checkpointId   String?             @map("checkpoint_id") @db.Uuid
  triggerType    ReminderTriggerType @map("trigger_type")
  scheduledAt    DateTime            @map("scheduled_at")
  status         ReminderStatus      @default(pending)
  completedAt    DateTime?           @map("completed_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  employee     Employee      @relation(fields: [employeeId], references: [id])
  longTermGoal LongTermGoal? @relation(fields: [longTermGoalId], references: [id])
  checkpoint   Checkpoint?   @relation(fields: [checkpointId], references: [id])

  @@index([employeeId])
  @@index([scheduledAt])
  @@map("reminder_schedules")
}

/// <one_on_one>要件。AIが1on1前に集約するサマリ。本人には非公開（UL専用の準備資料）とし、
/// unitLeaderIdを主体とするRLSを個人データテーブルとは別パターンで設定する
/// （migration側で個別定義、共通のself_all/ul_select_unit_scope/admin_selectパターンは
/// employeeId=対象メンバーを主体とする設計のため、この2テーブルには適用できない）。
model OneOnOnePrepSheet {
  id                       String        @id @default(uuid()) @db.Uuid
  /// 1on1の対象メンバー（本人はこのシート自体を閲覧できない）。
  employeeId               String        @map("employee_id") @db.Uuid
  unitLeaderId             String        @map("unit_leader_id") @db.Uuid
  previousSessionSummary   String?       @map("previous_session_summary")
  goalProgressSummary      String        @map("goal_progress_summary")
  changesSummary           String?       @map("changes_summary")
  issuesSummary            String?       @map("issues_summary")
  incompleteActionsSummary String?       @map("incomplete_actions_summary")
  achievementsSummary      String?       @map("achievements_summary")
  fieldContextSummary      String?       @map("field_context_summary")
  recommendedQuestions     String[]      @map("recommended_questions")
  goalRevisionCandidates   String[]      @map("goal_revision_candidates")
  nextActionCandidates     String[]      @map("next_action_candidates")
  source                   ContentSource @default(ai_inferred)
  generatedAt              DateTime      @default(now()) @map("generated_at")
  reviewedByUlAt           DateTime?     @map("reviewed_by_ul_at")

  member     Employee @relation("OneOnOnePrepSheetMember", fields: [employeeId], references: [id])
  unitLeader Employee @relation("OneOnOnePrepSheetLeader", fields: [unitLeaderId], references: [id])

  @@index([employeeId])
  @@index([unitLeaderId])
  @@map("one_on_one_prep_sheets")
}

enum OneOnOneSessionStatus {
  scheduled
  completed
  cancelled

  @@map("one_on_one_session_status")
}

/// 実施記録。notesはUL自身の判断・メモ（user_stated）。<one_on_one>「AIは最終判断をしない」を
/// PrepSheet(ai_inferred)とSession.notes(user_stated)の分離で構造的に実装する。
model OneOnOneSession {
  id           String                @id @default(uuid()) @db.Uuid
  employeeId   String                @map("employee_id") @db.Uuid
  unitLeaderId String                @map("unit_leader_id") @db.Uuid
  prepSheetId  String?               @map("prep_sheet_id") @db.Uuid
  scheduledAt  DateTime?             @map("scheduled_at")
  heldAt       DateTime?             @map("held_at")
  notes        String?
  status       OneOnOneSessionStatus @default(scheduled)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  member     Employee @relation("OneOnOneSessionMember", fields: [employeeId], references: [id])
  unitLeader Employee @relation("OneOnOneSessionLeader", fields: [unitLeaderId], references: [id])

  @@index([employeeId])
  @@index([unitLeaderId])
  @@map("one_on_one_sessions")
}

// ============================================================================
// MVP完成フェーズ: 通知 / 人事評価制度マスタ(評価期間・能力・職位) / アプリ設定
// Phase3 4章ドメインI「通知」(notifications、1テーブル)・ドメインB「会社制度資料」の
// evaluation_period_master/competency_master/position_masterを実装する
// （kpi_master/ulm_masterは既存実装済みのため対象外）。
// ============================================================================

/// Phase4 16章「Notification UX」の8種別に、<notification>要件で追加指示された
/// 「AIからの重要な提案」を加えた9種別。Phase3 13.2節の通知エンドポイント例
/// （reminder/escalation/one_on_one_scheduled/goal_revision_proposal/digest）を、
/// このアプリで実際に発火させるドメインイベント単位に具体化したもの
/// （Phase3のnotification_typeはvarchar(50)の自由文字列だが、既存の他status/type列と
/// 同じ規約でPostgres enumとして型安全に定義する）。
enum NotificationType {
  /// 行動期限/行動予定（Action.dueDateの到来）
  action_due
  /// 中間確認（ReminderSchedule triggerType=interim_check）
  interim_check
  /// 振り返り（ReminderSchedule triggerType=reflection）
  reflection_prompt
  /// 1on1準備（次回1on1が近い、またはUL向け準備シートがレビュー待ち）
  one_on_one_prep
  /// 未回答（AIからの質問に回答していない状態が一定期間継続）
  unanswered
  /// SMART未完了（SMART監査未実施、または不足のまま長期間放置）
  smart_incomplete
  /// 目標期限（ReminderSchedule triggerType=deadline）
  goal_deadline
  /// 目標更新（UL発の目標修正提案の到着、KPI改定によるunder_review化等）
  goal_updated
  /// AIからの重要な提案（GoalAiInsightのissue_detected/next_action_suggestion等）
  ai_important_suggestion

  @@map("notification_type")
}

/// Phase3 5.A `notifications.channel`。pushは将来拡張（Phase4 22章）のためMVPでは未実装。
enum NotificationChannel {
  in_app
  email

  @@map("notification_channel")
}

/// Phase3 5.A `notifications`（アプリ内通知の配信・既読状態）をそのまま実装。
/// <reminder>要件「リマインダーはULではなくアプリ中心で管理する」の配信層であり、
/// リマインダー以外の通知（1on1準備、目標修正提案の到着等）も同じ器で扱う
/// （Phase3 5.A notificationsの設計意図どおり）。
/// RLS: 個人の心理的機微データではなく「システムが本人に配信する通知」という性質上、
/// 既存の3層パターン(self=ALL/UL=SELECT/ADMIN=SELECT)ではなく、
/// self=SELECT+UPDATE（既読化のみ）、ADMIN=ALL（バックグラウンドワーカーが
/// withSystemBypass()で任意の受信者宛てに生成するための書き込み経路。監査ログ等と同じ
/// 「システム発行」の性質を持つレコードのため、他の個人反省的データテーブルとは
/// 異なる権限モデルを採用する。理由は完了報告に明記）とする独自2ポリシー構成にする。
model Notification {
  id                  String              @id @default(uuid()) @db.Uuid
  recipientEmployeeId String              @map("recipient_employee_id") @db.Uuid
  notificationType    NotificationType    @map("notification_type")
  title               String
  body                String
  /// ポリモーフィック参照元（例: 'action', 'reminder_schedule', 'one_on_one_session',
  /// 'goal_ai_insight', 'long_term_goal'）。DB外部キー制約は課さずアプリ層で検証する
  /// （WhyRecord.subjectType等と同じ設計規約）。
  relatedType         String?             @map("related_type")
  relatedId           String?             @map("related_id") @db.Uuid
  channel             NotificationChannel @default(in_app)
  deliveredAt         DateTime            @default(now()) @map("delivered_at")
  readAt              DateTime?           @map("read_at")
  createdAt           DateTime            @default(now()) @map("created_at")

  recipient Employee @relation(fields: [recipientEmployeeId], references: [id])

  @@index([recipientEmployeeId, readAt, deliveredAt(sort: Desc)])
  @@map("notifications")
}

/// Phase3 5.B `evaluation_period_master`。IDは人間可読文字列をそのままPKにする
/// （Phase3の設計をそのまま踏襲）。
model EvaluationPeriod {
  id              String               @id @db.VarChar(30)
  periodType      EvaluationPeriodType @map("period_type")
  periodStartDate DateTime             @map("period_start_date") @db.Date
  periodEndDate   DateTime             @map("period_end_date") @db.Date
  periodLabel     String               @map("period_label")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@map("evaluation_period_master")
}

enum EvaluationPeriodType {
  quarter
  half_year
  fiscal_year
  custom

  @@map("evaluation_period_type")
}

/// Phase3 5.B `competency_master`（能力マスタ）。
model Competency {
  id             String   @id @default(uuid()) @db.Uuid
  competencyName String   @unique @map("competency_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("competency_master")
}

/// Phase3 5.B `position_master`（職位マスタ）。Employee.positionIdとの紐付けは
/// Phase3原設計に存在するが、既存employeesテーブル（design freeze対象の確定済みモデル）への
/// 列追加は本フェーズのスコープ外とし、マスタの登録・改定機能のみを先行実装する
/// （完了報告に明記のうえ、残課題として扱う）。
model Position {
  id            String   @id @default(uuid()) @db.Uuid
  positionName  String   @unique @map("position_name")
  positionLevel Int      @map("position_level")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@map("position_master")
}

/// Phase4 ADM-09「アプリ設定」（通知既定値・リマインド閾値等の全社設定）。
/// Phase3の62テーブル一覧には存在しない新規テーブルであり、design freezeルール1
/// 「実装上必要な軽微な変更」として追加する（理由: Phase4 ADM-09画面は全社共通の設定値を
/// 永続化する先を必要とするが、Phase3はその保存先を明示的に設計していなかったため）。
/// シングルトン運用（1行のみ）とし、複数テナント対応は将来拡張の範囲外とする。
model AppSetting {
  /// シングルトン固定値。常に'default'の1行のみ存在する。
  id                        String   @id @default("default")
  /// 通知のダイジェスト配信（Phase4 23.8 M1、MVP後機能だが設定項目自体は先行して持たせる）
  notificationDigestEnabled Boolean  @default(false) @map("notification_digest_enabled")
  /// 目標のReminderSchedule自動生成における既定の中間確認間隔（日数）
  defaultInterimCheckDays   Int      @default(14) @map("default_interim_check_days")
  /// SMART未完了の再確認を促すまでの既定日数
  defaultSmartRecheckDays   Int      @default(90) @map("default_smart_recheck_days")
  updatedByEmployeeId       String?  @map("updated_by_employee_id") @db.Uuid
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
