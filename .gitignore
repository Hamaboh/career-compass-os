# OS
.DS_Store
Thumbs.db

# Node
node_modules/
npm-debug.log*
.pnpm-debug.log*

# Env / secrets — never commit real values (design_freeze rules: secrets are config, not design)
.env
.env.*
!.env.example

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Next.jsが `next dev`/`next build` の度に自動再生成する型参照ファイル。
# コミット対象に含めるとCI環境で生成タイミングがずれてlintの
# triple-slash-reference規則に引っかかる(2026-08-16、GitHub Actions初回実行で発覚)。
apps/web/next-env.d.ts

# Prisma
apps/api/prisma/migrations/.generated/

# Docker volumes mounted locally (if any bind-mounts are used during dev)
.docker-data/

# Test / coverage
coverage/
.nyc_output/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
logs/
